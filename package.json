{
  "name": "save-grandma",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "test": "vitest run",
    "check": "tsc -b && vitest run",
    "smoke": "node scripts/smoke.mjs",
    "build:server": "esbuild server/lambda.ts --bundle --platform=node --target=node22 --format=esm --external:@aws-sdk/* --outfile=dist-server/index.mjs",
    "build:deploy": "VITE_ELEVENLABS_VOICE=true npm run build && npm run build:server"
  },
  "dependencies": {
    "@openai/agents": "^0.19.0",
    "@react-three/fiber": "^9.3.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "three": "^0.180.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@aws-sdk/client-ssm": "^3.1148.0",
    "@types/node": "^22.18.0",
    "@types/react": "^19.1.13",
    "@types/react-dom": "^19.1.9",
    "@types/three": "^0.180.0",
    "@vitejs/plugin-react": "^5.0.3",
    "playwright": "^1.55.0",
    "typescript": "~5.9.2",
    "vite": "^7.1.7",
    "vitest": "^4.1.11"
  }
}
